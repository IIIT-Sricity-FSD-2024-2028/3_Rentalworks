DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SUPER_ADMIN_TOKEN_SECRET=REPLACE_ME

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Online payments (Razorpay). Leave empty to run payments in TEST MODE (no real money).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional signing secret of at least 32 characters. Without it sessions expire on backend restart.
# SESSION_COOKIE_SECRET=
# Comma-separated frontend origins for production or custom development ports.
# SESSION_FRONTEND_ORIGINS=http://localhost:5173
